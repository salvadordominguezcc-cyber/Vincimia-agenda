# Vincimia Agenda — copia este archivo como ".env.local" y pega tus valores.
# NUNCA subas .env.local a GitHub (ya está en .gitignore).
# Las variables NEXT_PUBLIC_ sí llegan al navegador; las demás solo las
# ve el servidor. No pegues llaves secretas en el código.

# --- Supabase (obligatorio para guardar datos reales) ---
# Supabase → tu proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo para rutas de servidor (webhook de Sheets). Nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de tu app. En Cloudflare Pages es https://vincimia-agenda.pages.dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Calendar, cuenta secundaria (Fase 2) ---
# Google Cloud → tu proyecto → APIs & Services → Credentials → OAuth 2.0
# Client ID. El redirect URI debe ser EXACTAMENTE el de abajo.
# Ver FASE2_SETUP.md. Sin estas dos variables, Conectores dice Pendiente.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://vincimia-agenda.pages.dev/api/google-calendar/callback

# --- WhatsApp Cloud API (Fase 2) ---
# Meta → tu app de WhatsApp Business → API Setup. Ver FASE2_SETUP.md.
# WHATSAPP_ACCESS_TOKEN es el token temporal o permanente de la app.
# WHATSAPP_PHONE_NUMBER_ID es el ID del número (no el número en sí).
# WHATSAPP_VERIFY_TOKEN lo inventas tú (una palabra secreta) y se pega
# igual en Meta al configurar el webhook.
# WHATSAPP_TEMPLATE_NAME es opcional: el nombre de la plantilla de
# confirmación aprobada en Meta. Sin plantilla, el bot manda texto libre
# (solo llega si el paciente escribió en las últimas 24 horas).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_TEMPLATE_NAME=
