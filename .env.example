# Vincimia Agenda — copia este archivo como ".env.local" y pega tus valores.
# NUNCA subas .env.local a GitHub (ya está en .gitignore).
# Las variables NEXT_PUBLIC_ sí llegan al navegador; las demás solo las
# ve el servidor. No pegues llaves secretas en el código.

# --- Supabase (obligatorio para guardar datos reales) ---
# Supabase → tu proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo para rutas de servidor (webhook de Sheets). Nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de tu app. En Cloudflare Pages es https://vincimia-agenda.pages.dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Calendar, cuenta secundaria (Fase 2) ---
# Google Cloud → tu proyecto → APIs & Services → Credentials → OAuth 2.0
# Client ID. El redirect URI debe ser EXACTAMENTE el de abajo.
# Ver FASE2_SETUP.md. Sin estas dos variables, Conectores dice Pendiente.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://vincimia-agenda.pages.dev/api/google-calendar/callback

# --- WhatsApp Cloud API (Fase 2) ---
# Meta → tu app de WhatsApp Business → API Setup. Ver FASE2_SETUP.md.
# WHATSAPP_ACCESS_TOKEN es el token temporal o permanente de la app.
# WHATSAPP_PHONE_NUMBER_ID es el ID del número (no el número en sí).
# WHATSAPP_VERIFY_TOKEN lo inventas tú (una palabra secreta) y se pega
# igual en Meta al configurar el webhook.
# WHATSAPP_TEMPLATE_NAME es opcional: el nombre de la plantilla de
# confirmación aprobada en Meta. Sin plantilla, el bot manda texto libre
# (solo llega si el paciente escribió en las últimas 24 horas).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_LINK_TEMPLATE_NAME es opcional: la plantilla del link de
# reserva con botón "Agendar cita" (categoría Utilidad, es_MX, 1 hueco:
# nombre del paciente). Por defecto es link_reserva. Sin plantilla
# aprobada, el bot manda el link como texto libre (solo llega si el
# paciente escribió en las últimas 24 horas).
# WHATSAPP_LINK_TEMPLATE_NAME=link_reserva
# --- Aviso al dueño al confirmar (FORMATO DE CITA para el grupo) ---
# Al confirmar una cita en la nube, además de la confirmación al
# paciente el bot manda al dueño el FORMATO DE CITA ya lleno por
# WhatsApp, para que él lo reenvíe al grupo de promotores (el bot no
# puede escribir en grupos: Meta solo permite mensajes 1 a 1).
# OWNER_WHATSAPP_NUMBER es el número del dueño en formato
# internacional sin "+" (ej. 526861140969 para 686 114 0969). Si no
# se pone, se usa el teléfono de dueño en Supabase si existe y, si
# no, 526861140969. Ver src/lib/owner-notify.ts y FASE2_SETUP.md.
# OWNER_WHATSAPP_NUMBER=

# --- Messenger e Instagram (Meta, canales nuevos) ---
# Misma app de Meta que WhatsApp Business (Fase 2), productos
# Messenger e Instagram. Ver FASE2_SETUP.md.
# META_PAGE_ACCESS_TOKEN es el token de la página de Facebook (el que
# contesta por Messenger). META_INSTAGRAM_TOKEN es el token de
# Instagram (token de la página con el permiso instagram_messaging,
# vinculado a la cuenta profesional de Instagram). META_VERIFY_TOKEN
# es la palabra secreta compartida para verificar los dos webhooks
# (/api/webhook/messenger y /api/webhook/instagram): se inventa y se
# pega igual en Meta y en Cloudflare. Sin estas variables, Conectores
# dice Pendiente y los webhooks no contestan nada.
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_TOKEN=
META_VERIFY_TOKEN=

# --- Creador de contenido (opcional, llaves que ya tienes) ---
# Gemini y Groq para textos y guiones. Sin ellas, Contenido usa las
# plantillas locales de src/lib/content.ts. Ver CONTENT_CREATOR.md.
# GEMINI_API_KEY=
# GROQ_API_KEY=

# --- Escritura inversa Agenda → hoja de promotores (solo prueba manual) ---
# Receptor de Apps Script (scripts/apps-script-agenda-a-sheets.gs) pegado
# en la hoja oficial AGENDA DE PROMOTORES 2026.xlsx, pestaña
# DENTIPLUS MEXICALI 1. SHEETS_RECEIVER_URL es la URL /exec de la
# aplicación web; SHEETS_RECEIVER_SECRET es el mismo secreto de
# CONFIG.SECRET en ese script. Sin estas dos variables, la ruta
# /api/sheets/push responde 503 y no se inventa ningún envío. La ruta
# solo se llama a mano: ningún flujo automático la usa todavía.
# SHEETS_RECEIVER_URL=
# SHEETS_RECEIVER_SECRET=

# --- Bot unificado (WhatsApp, Messenger e Instagram) ---
# Las llaves de arriba (GEMINI_API_KEY / GROQ_API_KEY) son el cerebro
# del bot unificado (src/lib/unified-bot.ts). Sin ellas, el bot
# responde con respuestas locales marcadas como demo ("sin conexión
# a la IA"). El WhatsApp único del consultorio es +52 663 328 0701
# (en código: WHATSAPP_CLINICA).
